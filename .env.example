NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cérebro da conversa: Anthropic (Claude). A chave pode ficar no banco
# (app_secrets.anthropic_api_key) ou aqui. Modelo padrão: claude-sonnet-5.
ANTHROPIC_API_KEY=
CONVERSATION_MODEL=claude-sonnet-5
# OpenAI segue necessária só para transcrever os áudios que o lead envia
# (Whisper) e para tarefas internas — a Anthropic não faz áudio.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

META_VERIFY_TOKEN=nexus-crm-verify-token
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
CLOSER_WHATSAPP_NUMBER=

# Prospecção de parceiros (FASE 5): chave da Google Places API (usada só no
# servidor). Sem ela, a busca de empresas fica indisponível.
GOOGLE_PLACES_API_KEY=

# Login do painel (sem essas 3 variáveis o app fica ABERTO, sem senha).
# AUTH_SECRET: string aleatória longa (ex.: saída de `openssl rand -hex 32`).
AUTH_EMAIL=
AUTH_PASSWORD=
AUTH_SECRET=

# Já usados pelo código mas não documentados antes:
# CRON_SECRET habilita o cron diário de follow-ups (Vercel envia sozinho).
# CRM_ADMIN_PIN libera o disparo de campanhas na tela Disparos.
CRON_SECRET=
CRM_ADMIN_PIN=
